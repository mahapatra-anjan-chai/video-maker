# Copy this file to .env and fill it in. .env is never committed.
# ElevenLabs (voiceover and sound effects): elevenlabs.io > Developers > API keys.
# Needs text to speech and sound effects; voices_read is optional (without it the built-in voice list is used).
ELEVENLABS_API_KEY=
# Optional. Leave empty and the model follows your plan: free accounts use eleven_flash_v2_5 (half the credits),
# paid accounts eleven_multilingual_v2 (the richer voice). Needs the key's "User: Read" permission to tell.
ELEVENLABS_MODEL=
