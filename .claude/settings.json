{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.tools/env.sh\"; [ -f \"$f\" ] && [ -n \"$CLAUDE_ENV_FILE\" ] && ! grep -qsF \"$(grep -m1 \"^export PATH\" \"$f\")\" \"$CLAUDE_ENV_FILE\" && cat \"$f\" >> \"$CLAUDE_ENV_FILE\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)"
    ]
  }
}
